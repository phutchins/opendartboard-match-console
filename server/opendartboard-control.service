[Unit]
Description=OpenDartboard Match Console host control
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/opendartboard-match-console/board_control.py
Restart=on-failure
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/opendartboard-control /var/lib/opendartboard-control
EnvironmentFile=-/etc/default/opendartboard-match-console
Environment=OPENDARTBOARD_STABLE_IMAGE=opendartboard:0.1.4
Environment=OPENDARTBOARD_MODIFIED_IMAGE=opendartboard:local
Environment=OPENDARTBOARD_DATA_DIR=/var/lib/opendartboard

[Install]
WantedBy=multi-user.target
